{
  "cleanUrls": true,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/barcelona",
      "destination": "/index.html"
    },
    {
      "source": "/bcn",
      "destination": "/index.html"
    },
    {
      "source": "/pre-barcelona",
      "destination": "/index.html"
    },
    {
      "source": "/speyer",
      "destination": "/index.html"
    },
    {
      "source": "/geng",
      "destination": "/index.html"
    },
    {
      "source": "/la",
      "destination": "/index.html"
    },
    {
      "source": "/australia",
      "destination": "/index.html"
    },
    {
      "source": "/ottawa",
      "destination": "/index.html"
    },
    {
      "source": "/api/neatqueue/:path*",
      "destination": "https://host.neatqueue.com/api/:path*"
    },
    {
      "source": "/api/v2/:path*",
      "destination": "https://host.neatqueue.com/api/v2/:path*"
    },
    {
      "source": "/api/v1/:path*",
      "destination": "https://host.neatqueue.com/api/v1/:path*"
    }
  ]
}
